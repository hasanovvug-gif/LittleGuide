{
  "expo": {
    "name": "LittleGuide",
    "slug": "littleguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "littleguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.littleguide.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.littleguide.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "aiProxyUrl": "",
      "aiAppToken": ""
    }
  }
}
